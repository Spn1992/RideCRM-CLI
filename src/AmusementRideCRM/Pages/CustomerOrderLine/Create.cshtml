@page
@model AmusementRideCRM.Pages.CustomerOrderLine.CreateModel
@{
    ViewData["Title"] = "Create CustomerOrderLine";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Create CustomerOrderLine</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Item.OrderId" class="form-label"></label>
                    <input asp-for="Item.OrderId" class="form-control" />
                    <span asp-validation-for="Item.OrderId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineNumber" class="form-label"></label>
                    <input asp-for="Item.LineNumber" class="form-control" />
                    <span asp-validation-for="Item.LineNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PartId" class="form-label"></label>
                    <input asp-for="Item.PartId" class="form-control" />
                    <span asp-validation-for="Item.PartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.RideId" class="form-label"></label>
                    <input asp-for="Item.RideId" class="form-control" />
                    <span asp-validation-for="Item.RideId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Quantity" class="form-label"></label>
                    <input asp-for="Item.Quantity" class="form-control" />
                    <span asp-validation-for="Item.Quantity" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UnitPriceUsd" class="form-label"></label>
                    <input asp-for="Item.UnitPriceUsd" class="form-control" />
                    <span asp-validation-for="Item.UnitPriceUsd" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineTotal" class="form-label"></label>
                    <input asp-for="Item.LineTotal" class="form-control" />
                    <span asp-validation-for="Item.LineTotal" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityReserved" class="form-label"></label>
                    <input asp-for="Item.QuantityReserved" class="form-control" />
                    <span asp-validation-for="Item.QuantityReserved" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityShipped" class="form-label"></label>
                    <input asp-for="Item.QuantityShipped" class="form-control" />
                    <span asp-validation-for="Item.QuantityShipped" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityBackordered" class="form-label"></label>
                    <input asp-for="Item.QuantityBackordered" class="form-control" />
                    <span asp-validation-for="Item.QuantityBackordered" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineStatus" class="form-label"></label>
                    <input asp-for="Item.LineStatus" class="form-control" />
                    <span asp-validation-for="Item.LineStatus" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="/CustomerOrderLine" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
