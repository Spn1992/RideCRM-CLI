@page
@model AmusementRideCRM.Pages.WarehouseLocation.IndexModel
@{
    ViewData["Title"] = "WarehouseLocation List";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">WarehouseLocation Management</h5>
            <a href="/WarehouseLocation/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Create New</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>LocationCode</th>
                            <th>LocationName</th>
                            <th>Zone</th>
                            <th>Aisle</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">@item.LocationId</td>
                                <td>@item.LocationCode</td>
                                <td>@item.LocationName</td>
                                <td>@item.Zone</td>
                                <td>@item.Aisle</td>
                                <td class="text-end pe-4">
                                    <a href="/WarehouseLocation/Details?id=@item.LocationId" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a>
                                    <a href="/WarehouseLocation/Edit?id=@item.LocationId" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
