@page
@model AmusementRideCRM.Pages.UserMaster.EditModel
@{
    ViewData["Title"] = "Edit UserMaster";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit UserMaster</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.UserId" />
                <div class="mb-3">
                    <label asp-for="Item.UserName" class="form-label"></label>
                    <input asp-for="Item.UserName" class="form-control" />
                    <span asp-validation-for="Item.UserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.NormalizedUserName" class="form-label"></label>
                    <input asp-for="Item.NormalizedUserName" class="form-control" />
                    <span asp-validation-for="Item.NormalizedUserName" class="text-danger"></span>
