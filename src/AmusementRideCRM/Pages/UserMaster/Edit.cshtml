                <div class="mb-3">
                    <label asp-for="Item.Email" class="form-label"></label>
                    <input asp-for="Item.Email" class="form-control" />
                    <span asp-validation-for="Item.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.NormalizedEmail" class="form-label"></label>
                    <input asp-for="Item.NormalizedEmail" class="form-control" />
                    <span asp-validation-for="Item.NormalizedEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PasswordHash" class="form-label"></label>
                    <input asp-for="Item.PasswordHash" class="form-control" />
                    <span asp-validation-for="Item.PasswordHash" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.FirstName" class="form-label"></label>
                    <input asp-for="Item.FirstName" class="form-control" />
                    <span asp-validation-for="Item.FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LastName" class="form-label"></label>
                    <input asp-for="Item.LastName" class="form-control" />
                    <span asp-validation-for="Item.LastName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.DisplayName" class="form-label"></label>
                    <input asp-for="Item.DisplayName" class="form-control" />
                    <span asp-validation-for="Item.DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PhoneNumber" class="form-label"></label>
                    <input asp-for="Item.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Item.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.RoleCode" class="form-label"></label>
                    <input asp-for="Item.RoleCode" class="form-control" />
                    <span asp-validation-for="Item.RoleCode" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsActive" class="form-label"></label>
                    <input asp-for="Item.IsActive" class="form-control" />
                    <span asp-validation-for="Item.IsActive" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsLocked" class="form-label"></label>
                    <input asp-for="Item.IsLocked" class="form-control" />
                    <span asp-validation-for="Item.IsLocked" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LockoutEnd" class="form-label"></label>
                    <input asp-for="Item.LockoutEnd" class="form-control" />
                    <span asp-validation-for="Item.LockoutEnd" class="text-danger"></span>
                </div>
                <div class="mb-3">
