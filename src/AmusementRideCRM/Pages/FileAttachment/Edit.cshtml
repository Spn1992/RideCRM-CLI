@page
@model AmusementRideCRM.Pages.FileAttachment.EditModel
@{
    ViewData["Title"] = "Edit FileAttachment";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit FileAttachment</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.AttachmentId" />
                <div class="mb-3">
                    <label asp-for="Item.EntityType" class="form-label"></label>
                    <input asp-for="Item.EntityType" class="form-control" />
                    <span asp-validation-for="Item.EntityType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.EntityId" class="form-label"></label>
                    <input asp-for="Item.EntityId" class="form-control" />
                    <span asp-validation-for="Item.EntityId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.FileName" class="form-label"></label>
                    <input asp-for="Item.FileName" class="form-control" />
                    <span asp-validation-for="Item.FileName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.FileExtension" class="form-label"></label>
                    <input asp-for="Item.FileExtension" class="form-control" />
                    <span asp-validation-for="Item.FileExtension" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ContentType" class="form-label"></label>
                    <input asp-for="Item.ContentType" class="form-control" />
                    <span asp-validation-for="Item.ContentType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.FileSizeBytes" class="form-label"></label>
                    <input asp-for="Item.FileSizeBytes" class="form-control" />
                    <span asp-validation-for="Item.FileSizeBytes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.StoragePath" class="form-label"></label>
                    <input asp-for="Item.StoragePath" class="form-control" />
                    <span asp-validation-for="Item.StoragePath" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <input asp-for="Item.Description" class="form-control" />
                    <span asp-validation-for="Item.Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedDate" class="form-label"></label>
                    <input asp-for="Item.UploadedDate" class="form-control" />
                    <span asp-validation-for="Item.UploadedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedBy" class="form-label"></label>
                    <input asp-for="Item.UploadedBy" class="form-control" />
                    <span asp-validation-for="Item.UploadedBy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsActive" class="form-label"></label>
                    <input asp-for="Item.IsActive" class="form-control" />
                    <span asp-validation-for="Item.IsActive" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/FileAttachment" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
