@page
@model AmusementRideCRM.Pages.VendorSource.EditModel
@{
    ViewData["Title"] = "Edit VendorSource";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit VendorSource</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.VendorSourceId" />
                <div class="mb-3">
                    <label asp-for="Item.PartId" class="form-label"></label>
                    <input asp-for="Item.PartId" class="form-control" />
                    <span asp-validation-for="Item.PartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.VendorId" class="form-label"></label>
                    <input asp-for="Item.VendorId" class="form-control" />
                    <span asp-validation-for="Item.VendorId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.VendorPartNumber" class="form-label"></label>
                    <input asp-for="Item.VendorPartNumber" class="form-control" />
                    <span asp-validation-for="Item.VendorPartNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.VendorDescription" class="form-label"></label>
                    <input asp-for="Item.VendorDescription" class="form-control" />
                    <span asp-validation-for="Item.VendorDescription" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LastKnownCostEur" class="form-label"></label>
                    <input asp-for="Item.LastKnownCostEur" class="form-control" />
                    <span asp-validation-for="Item.LastKnownCostEur" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LeadTimeDays" class="form-label"></label>
                    <input asp-for="Item.LeadTimeDays" class="form-control" />
                    <span asp-validation-for="Item.LeadTimeDays" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MinOrderQuantity" class="form-label"></label>
                    <input asp-for="Item.MinOrderQuantity" class="form-control" />
                    <span asp-validation-for="Item.MinOrderQuantity" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsPreferred" class="form-label"></label>
                    <input asp-for="Item.IsPreferred" class="form-control" />
                    <span asp-validation-for="Item.IsPreferred" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsActive" class="form-label"></label>
                    <input asp-for="Item.IsActive" class="form-control" />
                    <span asp-validation-for="Item.IsActive" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LastUpdated" class="form-label"></label>
                    <input asp-for="Item.LastUpdated" class="form-control" />
                    <span asp-validation-for="Item.LastUpdated" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedBy" class="form-label"></label>
                    <input asp-for="Item.CreatedBy" class="form-control" />
                    <span asp-validation-for="Item.CreatedBy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedBy" class="form-label"></label>
                    <input asp-for="Item.ModifiedBy" class="form-control" />
                    <span asp-validation-for="Item.ModifiedBy" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/VendorSource" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
