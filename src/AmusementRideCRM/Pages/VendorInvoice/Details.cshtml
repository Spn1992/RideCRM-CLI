@page
@model AmusementRideCRM.Pages.VendorInvoice.DetailsModel
@{
    ViewData["Title"] = "Split-Screen Invoice Review & Cost Variance Gate";
}

<div class="container-fluid py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-surface p-3 rounded-4 shadow-sm border">
        <div>
            <h4 class="mb-1 fw-bold text-primary-custom">
                <i class="bi bi-file-earmark-diff me-2"></i>Invoice Review: @Model.Item.InvoiceNumber
            </h4>
            <span class="text-muted small me-3"><i class="bi bi-building me-1"></i>Vendor ID: @(Model.Item.VendorId?.ToString() ?? "N/A")</span>
            <span class="text-muted small me-3"><i class="bi bi-bag-check me-1"></i>PO ID: @(Model.Item.PurchaseOrderId?.ToString() ?? "N/A")</span>
            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Date: @Model.Item.InvoiceDate?.ToString("yyyy-MM-dd")</span>
        </div>
        <div>
            @if (Model.Item.Status == "Pending Review")
            {
                <span class="badge bg-danger p-2 fs-6 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>Pending Review (Cost Shift > 5%)</span>
            }
            else if (Model.Item.Status == "Approved")
            {
                <span class="badge bg-success p-2 fs-6 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Approved (Synced / Ready)</span>
            }
            else
            {
                <span class="badge bg-secondary p-2 fs-6 shadow-sm">@Model.Item.Status</span>
            }
            <a href="/VendorInvoice" class="btn btn-outline-secondary btn-sm ms-2"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <!-- Integrated Split-Screen Interface -->
    <div class="row g-3">
        <!-- LEFT PANEL: Document Viewer -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 px-3">
                    <span class="fw-semibold"><i class="bi bi-file-earmark-pdf me-2 text-warning"></i>Uploaded Document Viewer</span>
                    <small class="text-light text-truncate" style="max-width: 250px;">@(Model.Item.UploadedFileName ?? "No Document")</small>
                </div>
                <div class="card-body p-0 bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="min-height: 750px;">
                    @if (!string.IsNullOrEmpty(Model.Item.UploadedFilePath))
                    {
                        <iframe src="@Model.Item.UploadedFilePath" style="width: 100%; height: 800px; border: none;"></iframe>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <i class="bi bi-file-earmark-text text-muted" style="font-size: 4rem;"></i>
                            <h5 class="mt-3 text-secondary">No Attachment Preview</h5>
                            <p class="text-muted small">An uploaded PDF invoice document will render side-by-side here.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Review Gate & Cost Variance Details -->
        <div class="col-lg-6">
            <div class="d-flex flex-column gap-3">

                <!-- Cost Variance Review Gate Banner -->
                @if (Model.Evaluation.HasDiscrepancy && Model.Item.Status != "Approved")
                {
                    <div class="card border-danger shadow-sm rounded-4 bg-danger bg-opacity-10">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-shield-exclamation text-danger fs-2 me-3 mt-1"></i>
                                <div>
                                    <h5 class="fw-bold text-danger mb-1">Cost Shift Review Gate Triggered</h5>
                                    <p class="mb-2 text-dark">
                                        Unit cost increases exceeding the <strong>5% threshold</strong> were detected.
                                        Automatic QuickBooks accounting sync and Part Master cost updates are <strong>blocked</strong> pending manager review.
                                    </p>
                                    <div class="p-2 bg-white rounded border border-danger-subtle text-danger small">
                                        <strong>Discrepancy Summary:</strong> @Model.Evaluation.DiscrepancyNotes
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- AI Extraction & Invoice Summary -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-surface border-bottom d-flex justify-content-between align-items-center py-2 px-3">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-robot me-2 text-primary"></i>AI Extraction & Header Summary</h6>
                        <span class="badge bg-info text-dark">
                            <i class="bi bi-cpu me-1"></i>AI Confidence: @((Model.Item.AiConfidenceScore ?? 0.95m) * 100)%
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 text-sm">
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Invoice Total</span>
                                <strong class="fs-6 text-primary">€@((Model.Item.TotalEur ?? 0m).ToString("F2"))</strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">SubTotal</span>
                                <strong>€@((Model.Item.SubTotalEur ?? 0m).ToString("F2"))</strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Freight</span>
                                <strong>€@((Model.Item.FreightEur ?? 0m).ToString("F2"))</strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Tax</span>
                                <strong>€@((Model.Item.TaxEur ?? 0m).ToString("F2"))</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Line Item Unit Cost Variance Table -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-surface border-bottom py-2 px-3">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2 text-primary"></i>Line Items & Cost Variance Analysis</h6>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Line #</th>
                                    <th>Part / Vendor Part</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Invoice Unit Cost</th>
                                    <th class="text-end">Baseline Rate</th>
                                    <th class="text-center">Variance</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Evaluation.LineVariances.Any())
                                {
                                    @foreach (var line in Model.Evaluation.LineVariances)
                                    {
                                        <tr class="@(line.ExceedsThreshold ? "table-danger" : "")">
                                            <td class="fw-semibold text-center">@line.LineNumber</td>
                                            <td>
                                                <div class="fw-bold text-truncate" style="max-width: 150px;">
                                                    @(line.VendorPartNumber ?? (line.PartId.HasValue ? $"Part #{line.PartId}" : "N/A"))
                                                </div>
                                                <small class="text-muted d-block text-truncate" style="max-width: 150px;">@line.Description</small>
                                            </td>
                                            <td class="text-end">@line.Quantity</td>
                                            <td class="text-end fw-bold">€@line.UnitCostEur.ToString("F2")</td>
                                            <td class="text-end">
                                                €@line.BaselineUnitCostEur.ToString("F2")
                                                <small class="d-block text-muted" style="font-size: 0.75rem;">@line.BaselineSource</small>
                                            </td>
                                            <td class="text-center fw-bold @(line.ExceedsThreshold ? "text-danger" : "text-success")">
                                                @(line.VariancePercentage >= 0 ? "+" : "")@line.VariancePercentage.ToString("F1")%
                                            </td>
                                            <td class="text-center">
                                                @if (line.ExceedsThreshold)
                                                {
                                                    <span class="badge bg-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cost Shift > 5%</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Match</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted p-4">No line items extracted.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Review Action / Manager Approval Card -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-surface border-bottom py-2 px-3">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2 text-primary"></i>Manager Review Gate & Approval</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Item.Status == "Pending Review" || (Model.Evaluation.HasDiscrepancy && Model.Item.Status != "Approved"))
                        {
                            <form method="post" asp-page-handler="Approve">
                                <input type="hidden" name="id" value="@Model.Item.VendorInvoiceId" />
                                <div class="mb-3">
                                    <label asp-for="ReviewNotes" class="form-label fw-bold">Manager Review Notes & Justification</label>
                                    <textarea asp-for="ReviewNotes" class="form-control" rows="3" placeholder="Enter review justification for cost shift variance..."></textarea>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="UpdatePartMasterCosts" id="chkUpdateParts" checked />
                                    <label class="form-check-label" for="chkUpdateParts">
                                        Update Part Master <code>LastVendorCostEur</code> with confirmed unit costs
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                                    <i class="bi bi-shield-check me-2"></i>Approve Cost Shift & Enqueue for QuickBooks Sync
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="bg-light p-3 rounded-3 border">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                                    <h6 class="fw-bold mb-0 text-success">Invoice Review Complete</h6>
                                </div>
                                <p class="mb-1 text-muted small"><strong>Reviewed By User ID:</strong> @(Model.Item.ReviewedByUserId?.ToString() ?? "System/Admin")</p>
                                <p class="mb-1 text-muted small"><strong>Reviewed Date:</strong> @(Model.Item.ReviewedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</p>
                                <p class="mb-0 text-muted small"><strong>Review Notes:</strong> @(Model.Item.ReviewNotes ?? "Approved and verified.")</p>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
