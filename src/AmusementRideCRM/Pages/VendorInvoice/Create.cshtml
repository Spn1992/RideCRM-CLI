@page
@model AmusementRideCRM.Pages.VendorInvoice.CreateModel
@{
    ViewData["Title"] = "Create Vendor Invoice";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-file-earmark-arrow-up me-2"></i>Create Vendor Invoice & PDF Upload</h5>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="alert alert-info border-0 shadow-sm mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Automated AI Document Extraction & Review Gate:</strong> Upload a vendor invoice PDF to automatically extract line item costs, verify unit prices against Purchase Orders / Part Master, and trigger cost variance review if increases exceed 5%.
                </div>
                <div class="mb-3">
                    <label asp-for="Item.VendorId" class="form-label"></label>
                    <input asp-for="Item.VendorId" class="form-control" />
                    <span asp-validation-for="Item.VendorId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PurchaseOrderId" class="form-label"></label>
                    <input asp-for="Item.PurchaseOrderId" class="form-control" />
                    <span asp-validation-for="Item.PurchaseOrderId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.InvoiceDate" class="form-label"></label>
                    <input asp-for="Item.InvoiceDate" class="form-control" />
                    <span asp-validation-for="Item.InvoiceDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.DueDate" class="form-label"></label>
                    <input asp-for="Item.DueDate" class="form-control" />
                    <span asp-validation-for="Item.DueDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Currency" class="form-label"></label>
                    <input asp-for="Item.Currency" class="form-control" />
                    <span asp-validation-for="Item.Currency" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.SubTotalEur" class="form-label"></label>
                    <input asp-for="Item.SubTotalEur" class="form-control" />
                    <span asp-validation-for="Item.SubTotalEur" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.FreightEur" class="form-label"></label>
                    <input asp-for="Item.FreightEur" class="form-control" />
                    <span asp-validation-for="Item.FreightEur" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.TaxEur" class="form-label"></label>
                    <input asp-for="Item.TaxEur" class="form-control" />
                    <span asp-validation-for="Item.TaxEur" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.TotalEur" class="form-label"></label>
                    <input asp-for="Item.TotalEur" class="form-control" />
                    <span asp-validation-for="Item.TotalEur" class="text-danger"></span>
                </div>
                <div class="card bg-light p-3 mb-3 border">
                    <h6 class="fw-bold mb-3 text-secondary">Exchange Rate Snapshot & USD Mirror</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Item.ExchangeRate" class="form-label">Exchange Rate (USD per foreign unit)</label>
                            <input asp-for="Item.ExchangeRate" class="form-control" step="0.0001" />
                            <span asp-validation-for="Item.ExchangeRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Item.ExchangeRateDate" class="form-label">Exchange Rate Snapshot Date</label>
                            <input asp-for="Item.ExchangeRateDate" class="form-control" type="date" />
                            <span asp-validation-for="Item.ExchangeRateDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label asp-for="Item.SubTotalUsd" class="form-label">SubTotal (USD)</label>
                            <input asp-for="Item.SubTotalUsd" class="form-control" readonly />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label asp-for="Item.FreightUsd" class="form-label">Freight (USD)</label>
                            <input asp-for="Item.FreightUsd" class="form-control" readonly />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label asp-for="Item.TotalUsd" class="form-label">Total (USD)</label>
                            <input asp-for="Item.TotalUsd" class="form-control" readonly />
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Status" class="form-label"></label>
                    <input asp-for="Item.Status" class="form-control" />
                    <span asp-validation-for="Item.Status" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedFileName" class="form-label"></label>
                    <input asp-for="Item.UploadedFileName" class="form-control" />
                    <span asp-validation-for="Item.UploadedFileName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedFilePath" class="form-label"></label>
                    <input asp-for="Item.UploadedFilePath" class="form-control" />
                    <span asp-validation-for="Item.UploadedFilePath" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.AiExtractionJson" class="form-label"></label>
                    <input asp-for="Item.AiExtractionJson" class="form-control" />
                    <span asp-validation-for="Item.AiExtractionJson" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.AiConfidenceScore" class="form-label"></label>
                    <input asp-for="Item.AiConfidenceScore" class="form-control" />
                    <span asp-validation-for="Item.AiConfidenceScore" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ReviewedByUserId" class="form-label"></label>
                    <input asp-for="Item.ReviewedByUserId" class="form-control" />
                    <span asp-validation-for="Item.ReviewedByUserId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ReviewedDate" class="form-label"></label>
                    <input asp-for="Item.ReviewedDate" class="form-control" />
                    <span asp-validation-for="Item.ReviewedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ReviewNotes" class="form-label"></label>
                    <input asp-for="Item.ReviewNotes" class="form-control" />
                    <span asp-validation-for="Item.ReviewNotes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.HasDiscrepancy" class="form-label"></label>
                    <input asp-for="Item.HasDiscrepancy" class="form-control" />
                    <span asp-validation-for="Item.HasDiscrepancy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.DiscrepancyNotes" class="form-label"></label>
                    <input asp-for="Item.DiscrepancyNotes" class="form-control" />
                    <span asp-validation-for="Item.DiscrepancyNotes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QBBillTxnID" class="form-label"></label>
                    <input asp-for="Item.QBBillTxnID" class="form-control" />
                    <span asp-validation-for="Item.QBBillTxnID" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QBBillEditSequence" class="form-label"></label>
                    <input asp-for="Item.QBBillEditSequence" class="form-control" />
                    <span asp-validation-for="Item.QBBillEditSequence" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedDate" class="form-label"></label>
                    <input asp-for="Item.UploadedDate" class="form-control" />
                    <span asp-validation-for="Item.UploadedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UploadedBy" class="form-label"></label>
                    <input asp-for="Item.UploadedBy" class="form-control" />
                    <span asp-validation-for="Item.UploadedBy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedBy" class="form-label"></label>
                    <input asp-for="Item.CreatedBy" class="form-control" />
                    <span asp-validation-for="Item.CreatedBy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>

                <div class="card bg-light border-0 p-3 mb-4">
                    <label class="form-label fw-bold">Upload Invoice Document (PDF)</label>
                    <input type="file" name="UploadedFile" class="form-control form-control-lg" accept=".pdf,.png,.jpg,.jpeg,.json" />
                    <div class="form-text">Select a vendor invoice PDF or document file. Automated AI extraction will parse line items and verify cost variances.</div>
                </div>

                <h6 class="fw-bold mb-3">Invoice Header Details</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Item.InvoiceNumber" class="form-label">Invoice Number</label>
                        <input asp-for="Item.InvoiceNumber" class="form-control" placeholder="e.g. INV-2026-001" />
                        <span asp-validation-for="Item.InvoiceNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Item.VendorId" class="form-label">Vendor ID</label>
                        <input asp-for="Item.VendorId" class="form-control" type="number" placeholder="Vendor ID" />
                        <span asp-validation-for="Item.VendorId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Item.PurchaseOrderId" class="form-label">Purchase Order ID</label>
                        <input asp-for="Item.PurchaseOrderId" class="form-control" type="number" placeholder="PO ID" />
                        <span asp-validation-for="Item.PurchaseOrderId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Item.InvoiceDate" class="form-label">Invoice Date</label>
                        <input asp-for="Item.InvoiceDate" class="form-control" type="date" />
                        <span asp-validation-for="Item.InvoiceDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Item.DueDate" class="form-label">Due Date</label>
                        <input asp-for="Item.DueDate" class="form-control" type="date" />
                        <span asp-validation-for="Item.DueDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Item.Currency" class="form-label">Currency</label>
                        <input asp-for="Item.Currency" class="form-control" value="EUR" />
                        <span asp-validation-for="Item.Currency" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Item.SubTotalEur" class="form-label">SubTotal (€)</label>
                        <input asp-for="Item.SubTotalEur" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Item.FreightEur" class="form-label">Freight (€)</label>
                        <input asp-for="Item.FreightEur" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Item.TaxEur" class="form-label">Tax (€)</label>
                        <input asp-for="Item.TaxEur" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Item.TotalEur" class="form-label">Total (€)</label>
                        <input asp-for="Item.TotalEur" class="form-control" type="number" step="0.01" />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-file-earmark-check me-1"></i> Upload & Process Invoice</button>
                    <a href="/VendorInvoice" class="btn btn-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const subTotalEur = document.querySelector('input[name="Item.SubTotalEur"]');
            const freightEur = document.querySelector('input[name="Item.FreightEur"]');
            const totalEur = document.querySelector('input[name="Item.TotalEur"]');
            const exchangeRate = document.querySelector('input[name="Item.ExchangeRate"]');

            const subTotalUsd = document.querySelector('input[name="Item.SubTotalUsd"]');
            const freightUsd = document.querySelector('input[name="Item.FreightUsd"]');
            const totalUsd = document.querySelector('input[name="Item.TotalUsd"]');

            function recalculateUsd() {
                const rate = parseFloat(exchangeRate?.value) || 1.0;
                const sub = parseFloat(subTotalEur?.value) || 0.0;
                const freight = parseFloat(freightEur?.value) || 0.0;
                let tot = parseFloat(totalEur?.value);
                if (isNaN(tot)) {
                    tot = sub + freight;
                }

                if (subTotalUsd) subTotalUsd.value = (sub * rate).toFixed(2);
                if (freightUsd) freightUsd.value = (freight * rate).toFixed(2);
                if (totalUsd) totalUsd.value = (tot * rate).toFixed(2);
            }

            [subTotalEur, freightEur, totalEur, exchangeRate].forEach(el => {
                if (el) {
                    el.addEventListener("input", recalculateUsd);
                    el.addEventListener("change", recalculateUsd);
                }
            });
            recalculateUsd();
        });
    </script>
}
