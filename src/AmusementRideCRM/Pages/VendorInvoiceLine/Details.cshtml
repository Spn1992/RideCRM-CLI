@page
@model AmusementRideCRM.Pages.VendorInvoiceLine.DetailsModel
@{
    ViewData["Title"] = "VendorInvoiceLine Details";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">VendorInvoiceLine Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">VILineId</dt>
                <dd class="col-sm-9">@Model.Item.VILineId</dd>
                <dt class="col-sm-3">VendorInvoiceId</dt>
                <dd class="col-sm-9">@Model.Item.VendorInvoiceId</dd>
                <dt class="col-sm-3">LineNumber</dt>
                <dd class="col-sm-9">@Model.Item.LineNumber</dd>
                <dt class="col-sm-3">PartId</dt>
                <dd class="col-sm-9">@Model.Item.PartId</dd>
                <dt class="col-sm-3">VendorPartNumber</dt>
                <dd class="col-sm-9">@Model.Item.VendorPartNumber</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Item.Description</dd>
                <dt class="col-sm-3">Quantity</dt>
                <dd class="col-sm-9">@Model.Item.Quantity</dd>
                <dt class="col-sm-3">UnitCostEur</dt>
                <dd class="col-sm-9">@Model.Item.UnitCostEur</dd>
                <dt class="col-sm-3">LineTotalEur</dt>
                <dd class="col-sm-9">@Model.Item.LineTotalEur</dd>
                <dt class="col-sm-3">POLineId</dt>
                <dd class="col-sm-9">@Model.Item.POLineId</dd>
                <dt class="col-sm-3">AiMatchConfidence</dt>
                <dd class="col-sm-9">@Model.Item.AiMatchConfidence</dd>
                <dt class="col-sm-3">IsMatchConfirmed</dt>
                <dd class="col-sm-9">@Model.Item.IsMatchConfirmed</dd>
                <dt class="col-sm-3">MatchedByUserId</dt>
                <dd class="col-sm-9">@Model.Item.MatchedByUserId</dd>
                <dt class="col-sm-3">CreatedDate</dt>
                <dd class="col-sm-9">@Model.Item.CreatedDate</dd>
                <dt class="col-sm-3">ModifiedDate</dt>
                <dd class="col-sm-9">@Model.Item.ModifiedDate</dd>
            </dl>
        </div>
        <div class="card-footer bg-light text-end">
            <a href="/VendorInvoiceLine/Edit?id=@Model.Item.VILineId" class="btn btn-primary">Edit</a>
            <a href="/VendorInvoiceLine" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
