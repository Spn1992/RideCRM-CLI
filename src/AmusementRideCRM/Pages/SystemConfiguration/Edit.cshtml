@page
@model AmusementRideCRM.Pages.SystemConfiguration.EditModel
@{
    ViewData["Title"] = "Edit SystemConfiguration";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit SystemConfiguration</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.ConfigId" />
                <div class="mb-3">
                    <label asp-for="Item.ConfigKey" class="form-label"></label>
                    <input asp-for="Item.ConfigKey" class="form-control" />
                    <span asp-validation-for="Item.ConfigKey" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ConfigValue" class="form-label"></label>
                    <input asp-for="Item.ConfigValue" class="form-control" />
                    <span asp-validation-for="Item.ConfigValue" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.DataType" class="form-label"></label>
                    <input asp-for="Item.DataType" class="form-control" />
                    <span asp-validation-for="Item.DataType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <input asp-for="Item.Description" class="form-control" />
                    <span asp-validation-for="Item.Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Category" class="form-label"></label>
                    <input asp-for="Item.Category" class="form-control" />
                    <span asp-validation-for="Item.Category" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsEditable" class="form-label"></label>
                    <input asp-for="Item.IsEditable" class="form-control" />
                    <span asp-validation-for="Item.IsEditable" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedBy" class="form-label"></label>
                    <input asp-for="Item.ModifiedBy" class="form-control" />
                    <span asp-validation-for="Item.ModifiedBy" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/SystemConfiguration" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
