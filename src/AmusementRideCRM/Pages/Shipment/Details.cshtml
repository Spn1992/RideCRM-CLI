@page
@model AmusementRideCRM.Pages.Shipment.DetailsModel
@{
    ViewData["Title"] = "Shipment Details";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Shipment Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ShipmentId</dt>
                <dd class="col-sm-9">@Model.Item.ShipmentId</dd>
                <dt class="col-sm-3">ShipmentNumber</dt>
                <dd class="col-sm-9">@Model.Item.ShipmentNumber</dd>
                <dt class="col-sm-3">OrderId</dt>
                <dd class="col-sm-9">@Model.Item.OrderId</dd>
                <dt class="col-sm-3">ShipmentDate</dt>
                <dd class="col-sm-9">@Model.Item.ShipmentDate</dd>
                <dt class="col-sm-3">ShippedByUserId</dt>
                <dd class="col-sm-9">@Model.Item.ShippedByUserId</dd>
                <dt class="col-sm-3">Carrier</dt>
                <dd class="col-sm-9">@Model.Item.Carrier</dd>
                <dt class="col-sm-3">ServiceType</dt>
                <dd class="col-sm-9">@Model.Item.ServiceType</dd>
                <dt class="col-sm-3">TrackingNumber</dt>
                <dd class="col-sm-9">@Model.Item.TrackingNumber</dd>
