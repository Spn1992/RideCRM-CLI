@page
@model AmusementRideCRM.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders & Quotes";
    ViewData["ActivePage"] = "Orders";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Recent Orders</h5>
            <button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> New Order</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Orders != null && Model.Orders.Any())
                        {
                            foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-primary">@order.OrderNumber</td>
                                    <td>
                                        <span class="badge @(order.OrderType == "Quote" ? "bg-info" : "bg-primary")">@order.OrderType</span>
                                    </td>
                                    <td>
                                        <span class="badge @(order.Status == "Draft" ? "bg-secondary" : "bg-success")">@order.Status</span>
                                    </td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4 fw-medium">@order.TotalAmount.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No orders found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
