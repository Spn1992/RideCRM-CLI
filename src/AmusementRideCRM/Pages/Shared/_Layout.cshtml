<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AmusementRideCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-canvas text-primary-custom d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1">
        <!-- Sidebar Navigation -->
        <nav class="sidebar bg-surface border-end d-flex flex-column py-3 px-2 d-none d-md-flex" style="width: 250px; flex-shrink: 0;">
            <div class="d-flex align-items-center mb-4 px-3">
                <i class="bi bi-rocket-takeoff-fill text-primary fs-3 me-2"></i>
                <span class="fs-5 fw-bold">ApexRide ERP</span>
            </div>

            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a href="/" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-grid-1x2 me-2"></i> Command Center
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Orders" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Orders" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-journal-check me-2"></i> Orders &amp; Quotes
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/Customer" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Customers" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-people me-2"></i> Customers
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Part" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Parts" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-box-seam me-2"></i> Inventory Parts
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/PurchaseOrder" class="nav-link @(ViewData["ActivePage"]?.ToString() == "PurchaseOrders" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-cart-check me-2"></i> Purchase Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/VendorMaster" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Vendors" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-truck me-2"></i> Vendors
                    </a>
                </li>
            </ul>

            <div class="mt-auto px-3">
                <hr />
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-circle fs-4 me-2 text-secondary-custom"></i>
                    <div class="lh-sm">
                        <div class="fw-semibold" style="font-size: 0.9rem;">Admin User</div>
                        <div class="text-tertiary" style="font-size: 0.8rem;">admin@apexride.com</div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column overflow-hidden">
            <!-- Header for mobile / utilities -->
            <header class="bg-surface border-bottom py-2 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button class="btn btn-light d-md-none me-2"><i class="bi bi-list"></i></button>
                    <h5 class="mb-0 fw-semibold">@ViewData["Title"]</h5>
                </div>
                <div>
                    <button class="btn btn-light rounded-circle"><i class="bi bi-bell"></i></button>
                </div>
            </header>

            <!-- Page Content -->
            <main class="flex-grow-1 overflow-auto p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
