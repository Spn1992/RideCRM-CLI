<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AmusementRideCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-canvas text-primary-custom d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1">
        <!-- Sidebar Navigation -->
        <nav class="sidebar bg-surface border-end d-flex flex-column py-3 px-2 d-none d-md-flex overflow-auto" style="width: 260px; flex-shrink: 0;">
            <div class="d-flex align-items-center mb-3 px-3">
                <i class="bi bi-rocket-takeoff-fill text-primary fs-3 me-2"></i>
                <span class="fs-5 fw-bold">ApexRide ERP</span>
            </div>

            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a href="/" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-grid-1x2 me-2"></i> Command Center
                    </a>
                </li>

                <li class="nav-header px-3 pt-2 text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">CRM</li>
                <li class="nav-item">
                    <a href="/Customer" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Customers" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-people me-2"></i> Customers
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/CustomerContact" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Contacts" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-person-lines-fill me-2"></i> Contacts
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/CustomerRide" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Rides" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-ticket-detailed me-2"></i> Customer Rides
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/CustomerOrder" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Orders" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-journal-check me-2"></i> Orders &amp; Quotes
                    </a>
                </li>

                <li class="nav-header px-3 pt-2 text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Inventory</li>
                <li class="nav-item">
                    <a href="/Part" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Parts" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-box-seam me-2"></i> Parts
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/WarehouseLocation" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "WarehouseLocations" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-building me-2"></i> Warehouse Locations
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/HoldingLocation" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "HoldingLocations" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-geo-alt me-2"></i> Holding Locations
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/InventoryReservation" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Reservations" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-bookmark-check me-2"></i> Reservations
                    </a>
                </li>

                <li class="nav-header px-3 pt-2 text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Purchasing</li>
                <li class="nav-item">
                    <a href="/PurchaseOrder" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "PurchaseOrders" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-cart-check me-2"></i> Purchase Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/VendorMaster" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Vendors" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-truck me-2"></i> Vendors
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/VendorInvoice" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "VendorInvoices" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-receipt me-2"></i> Vendor Invoices
                    </a>
                </li>

                <li class="nav-header px-3 pt-2 text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Fulfillment</li>
                <li class="nav-item">
                    <a href="/ReceivingRecord" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Receiving" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-box-arrow-in-down me-2"></i> Receiving
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Shipment" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Shipments" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-box-arrow-up-right me-2"></i> Shipments
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/CustomerInvoice" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "CustomerInvoices" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i> Customer Invoices
                    </a>
                </li>

                <li class="nav-header px-3 pt-2 text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">System</li>
                <li class="nav-item">
                    <a href="/SystemConfiguration" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "SystemConfig" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-gear me-2"></i> Configuration
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/AuditLog" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "AuditLog" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-clipboard-data me-2"></i> Audit Log
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/ErrorLogging" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "ErrorLog" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-exclamation-triangle me-2"></i> Error Log
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/FileAttachment" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Attachments" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-paperclip me-2"></i> File Attachments
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/NotificationQueue" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "Notifications" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-bell-fill me-2"></i> Notifications
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/NumberSequence" class="nav-link py-1 @(ViewData["ActivePage"]?.ToString() == "NumberSequences" ? "active" : "text-secondary-custom")">
                        <i class="bi bi-hash me-2"></i> Number Sequences
                    </a>
                </li>
            </ul>

            <div class="mt-auto px-3">
                <hr />
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-circle fs-4 me-2 text-secondary-custom"></i>
                    <div class="lh-sm">
                        <div class="fw-semibold" style="font-size: 0.9rem;">Admin User</div>
                        <div class="text-tertiary" style="font-size: 0.8rem;">admin@apexride.com</div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column overflow-hidden">
            <!-- Header for mobile / utilities -->
            <header class="bg-surface border-bottom py-2 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button class="btn btn-light d-md-none me-2"><i class="bi bi-list"></i></button>
                    <h5 class="mb-0 fw-semibold">@ViewData["Title"]</h5>
                </div>
                <div>
                    <button class="btn btn-light rounded-circle"><i class="bi bi-bell"></i></button>
                </div>
            </header>

            <!-- Page Content -->
            <main class="flex-grow-1 overflow-auto p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
