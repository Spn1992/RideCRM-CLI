@page
@model AmusementRideCRM.Pages.ReceivingRecord.DetailsModel
@{
    ViewData["Title"] = "Receiving Record Details";
    ViewData["ActivePage"] = "Receiving";
}

<div class="container-fluid">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Receiving Gate Alert</h5>
            <div asp-validation-summary="All"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header with Receiving Number and Status -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0 fw-bold">Receiving Record @Model.Item.ReceivingNumber</h3>
            <span class="text-muted">PO #: @(Model.PurchaseOrder?.PONumber ?? $"PO #{Model.Item.PurchaseOrderId}") | Date: @Model.Item.ReceivingDate.ToString("yyyy-MM-dd")</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success fs-6 px-3 py-2">Status: @(string.IsNullOrEmpty(Model.Item.Status) ? "Draft" : Model.Item.Status)</span>

            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Item.ReceivingId" class="d-inline-flex gap-1">
                <select name="status" class="form-select form-select-sm" style="width: auto;">
                    <option value="Draft" selected="@(Model.Item.Status == "Draft")">Draft</option>
                    <option value="Received" selected="@(Model.Item.Status == "Received")">Received</option>
                    <option value="Inspected" selected="@(Model.Item.Status == "Inspected")">Inspected</option>
                    <option value="Completed" selected="@(Model.Item.Status == "Completed")">Completed</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-success">Update Status</button>
            </form>

            <a href="/ReceivingRecord/Edit?id=@Model.Item.ReceivingId" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit Record</a>
            <a href="/ReceivingRecord" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>
    </div>

    <!-- Receiving Summary Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Receiving Information</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Vendor</span>
                    <span class="fw-semibold">@(Model.Vendor?.VendorName ?? $"Vendor #{Model.Item.VendorId}")</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Carrier</span>
                    <span>@(string.IsNullOrEmpty(Model.Item.CarrierName) ? "N/A" : Model.Item.CarrierName)</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Tracking Number</span>
                    <span>@(string.IsNullOrEmpty(Model.Item.TrackingNumber) ? "N/A" : Model.Item.TrackingNumber)</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Packing Slip #</span>
                    <span>@(string.IsNullOrEmpty(Model.Item.PackingSlipNumber) ? "N/A" : Model.Item.PackingSlipNumber)</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Has Discrepancy</span>
                    <span class="badge @(Model.Item.HasDiscrepancy ? "bg-danger" : "bg-secondary")">@(Model.Item.HasDiscrepancy ? "Yes" : "No")</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Discrepancy Notes</span>
                    <span>@(string.IsNullOrEmpty(Model.Item.DiscrepancyNotes) ? "-" : Model.Item.DiscrepancyNotes)</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PutawayDirectives.Any())
    {
        <!-- Putaway & Holding Bin Transfer Guidance Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-warning">
            <div class="card-header bg-surface border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-signpost-split me-2 text-warning"></i>Putaway Directives & Holding Location Guidance</h5>
                <span class="badge bg-warning text-dark"><i class="bi bi-box-seam me-1"></i>Action Required</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Part Number</th>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th>Destination Type</th>
                                <th>Bin Location</th>
                                <th>Transfer Guidance & Directives</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dir in Model.PutawayDirectives)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold"><span class="badge bg-light text-dark font-monospace">@dir.PartNumber</span></td>
                                    <td>@dir.Description</td>
                                    <td class="text-end fw-bold">@dir.Quantity.ToString("N0")</td>
                                    <td>
                                        @if (dir.DestinationType == "Holding Allocation")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-pin-angle me-1"></i>Holding Allocation</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-archive me-1"></i>Standard Putaway</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-dark font-monospace">@dir.LocationCode</span></td>
                                    <td class="small fw-semibold text-dark">@dir.GuidanceNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Receiving Lines Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-box-arrow-in-down me-2"></i>Received Line Items</h5>
            <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addRecLineCollapse">
                <i class="bi bi-plus-lg me-1"></i> Receive Item
            </button>
        </div>

        <!-- Receive Line Item Form -->
        <div class="collapse p-3 bg-light border-bottom" id="addRecLineCollapse">
            <form method="post" asp-page-handler="AddLine" asp-route-id="@Model.Item.ReceivingId">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Part</label>
                        <select asp-for="NewLine.PartId" class="form-select form-select-sm" required>
                            <option value="">-- Select Part --</option>
                            @foreach (var part in Model.AvailableParts)
                            {
                                <option value="@part.PartId">@part.PartNumber - @part.Description @(part.IsSerialized ? "[SERIALIZED]" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">PO Line Item (Optional)</label>
                        <select asp-for="NewLine.POLineId" class="form-select form-select-sm">
                            <option value="0">-- Select PO Line --</option>
                            @foreach (var poLine in Model.POLines)
                            {
                                <option value="@poLine.POLineId">Line #@poLine.LineNumber (Ordered: @poLine.Quantity, Received: @poLine.QuantityReceived)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Qty Expected</label>
                        <input asp-for="NewLine.QuantityExpected" class="form-control form-control-sm" type="number" step="0.01" value="1" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Qty Received</label>
                        <input asp-for="NewLine.QuantityReceived" class="form-control form-control-sm" type="number" step="0.01" value="1" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Label Qty (Zebra)</label>
                        <input asp-for="NewLine.LabelQty" class="form-control form-control-sm" type="number" value="1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Supervisor Authorization Username (If Over-Delivery / Damaged)</label>
                        <input asp-for="SupervisorUsername" class="form-control form-control-sm" placeholder="e.g. SupervisorUser" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Discrepancy Notes (Required for Over-Delivery / Damaged)</label>
                        <input asp-for="DiscrepancyNotesInput" class="form-control form-control-sm" placeholder="Enter reason for quantity variance or damage notes..." />
                    </div>
                    <div class="col-12 mt-2">
                        <label class="form-label small fw-semibold">Serial Numbers (If Serialized Part - one per line or comma separated)</label>
                        <textarea asp-for="SerialNumbersInput" class="form-control form-control-sm" rows="2" placeholder="e.g. SN-001, SN-002"></textarea>
                    </div>
                    <div class="col-12 mt-2 text-end">
                        <button type="submit" class="btn btn-sm btn-success px-4"><i class="bi bi-check-circle me-1"></i> Process Receipt</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0 align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Part Number</th>
                            <th>Description</th>
                            <th class="text-end">Qty Expected</th>
                            <th class="text-end">Qty Received</th>
                            <th class="text-end">Qty Damaged</th>
                            <th>Discrepancy</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ReceivingLines.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No items received in this record yet. Click 'Receive Item' above.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var line in Model.ReceivingLines)
                            {
                                var part = Model.PartsDict.ContainsKey(line.PartId) ? Model.PartsDict[line.PartId] : null;
                                var isDisc = line.HasDiscrepancy == "Yes" || line.HasDiscrepancy == "True";
                                <tr>
                                    <td class="ps-4 fw-semibold">@line.ReceivingLineId</td>
                                    <td><span class="badge bg-light text-dark font-monospace">@(part?.PartNumber ?? $"Part #{line.PartId}")</span></td>
                                    <td>@(part?.Description ?? "-")</td>
                                    <td class="text-end">@line.QuantityExpected.ToString("N2")</td>
                                    <td class="text-end text-success fw-bold">@line.QuantityReceived.ToString("N2")</td>
                                    <td class="text-end text-danger">@line.QuantityDamaged.ToString("N2")</td>
                                    <td>
                                        @if (isDisc)
                                        {
                                            <span class="badge bg-danger" title="@line.DiscrepancyNotes"><i class="bi bi-exclamation-octagon me-1"></i>Discrepancy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">Clear</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(line.DiscrepancyNotes) ? (string.IsNullOrEmpty(line.Notes) ? "-" : line.Notes) : line.DiscrepancyNotes)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.DiscrepancyAuditLogs.Any())
    {
        <!-- Supervisor Authorization Audit Log Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-surface border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-shield-check me-2"></i>Supervisor Discrepancy Approvals & Audit Trail</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Timestamp</th>
                                <th>Supervisor</th>
                                <th>Action</th>
                                <th>Audit Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var audit in Model.DiscrepancyAuditLogs)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@audit.AuditDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="badge bg-info text-dark">@audit.UserName</span></td>
                                    <td><span class="badge bg-warning text-dark">@audit.ActionType</span></td>
                                    <td class="small">@audit.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.SerializedUnits.Any())
    {
        <!-- Serialized Part Units Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-surface border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-qr-code me-2"></i>Serialized Units Received</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Unit ID</th>
                                <th>Part Number</th>
                                <th>Serial Number</th>
                                <th>Status</th>
                                <th>Received Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in Model.SerializedUnits)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@unit.SerializedPartUnitId</td>
                                    <td><span class="badge bg-light text-dark font-monospace">@(unit.Part?.PartNumber ?? $"Part #{unit.PartId}")</span></td>
                                    <td><span class="badge bg-secondary font-monospace">@unit.SerialNumber</span></td>
                                    <td><span class="badge bg-info text-dark">@unit.Status</span></td>
                                    <td>@unit.ReceivedDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.PrintJobs.Any())
    {
        <!-- Spooled ZPL Print Jobs Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-surface border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-printer me-2"></i>Spooled ZPL Barcode Print Jobs</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Job ID</th>
                                <th>Printer</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>ZPL Preview</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model.PrintJobs)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@job.PrintJobId</td>
                                    <td>@job.PrinterName</td>
                                    <td><span class="badge bg-success">@job.Status</span></td>
                                    <td>@job.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><code class="small text-muted">@job.ZplCommand.Replace("\r", "").Replace("\n", " ")</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

