@page
@model AmusementRideCRM.Pages.PartRideApplication.DetailsModel
@{
    ViewData["Title"] = "PartRideApplication Details";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">PartRideApplication Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">PartRideAppId</dt>
                <dd class="col-sm-9">@Model.Item.PartRideAppId</dd>
                <dt class="col-sm-3">PartId</dt>
                <dd class="col-sm-9">@Model.Item.PartId</dd>
                <dt class="col-sm-3">RideManufacturer</dt>
                <dd class="col-sm-9">@Model.Item.RideManufacturer</dd>
                <dt class="col-sm-3">RideModel</dt>
                <dd class="col-sm-9">@Model.Item.RideModel</dd>
                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.Item.Notes</dd>
                <dt class="col-sm-3">CreatedDate</dt>
                <dd class="col-sm-9">@Model.Item.CreatedDate</dd>
                <dt class="col-sm-3">CreatedBy</dt>
                <dd class="col-sm-9">@Model.Item.CreatedBy</dd>
            </dl>
        </div>
        <div class="card-footer bg-light text-end">
            <a href="/PartRideApplication/Edit?id=@Model.Item.PartRideAppId" class="btn btn-primary">Edit</a>
            <a href="/PartRideApplication" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
