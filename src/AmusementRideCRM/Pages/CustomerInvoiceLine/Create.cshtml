@page
@model AmusementRideCRM.Pages.CustomerInvoiceLine.CreateModel
@{
    ViewData["Title"] = "Create CustomerInvoiceLine";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Create CustomerInvoiceLine</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Item.InvoiceId" class="form-label"></label>
                    <input asp-for="Item.InvoiceId" class="form-control" />
                    <span asp-validation-for="Item.InvoiceId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineNumber" class="form-label"></label>
                    <input asp-for="Item.LineNumber" class="form-control" />
                    <span asp-validation-for="Item.LineNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineType" class="form-label"></label>
                    <input asp-for="Item.LineType" class="form-control" />
                    <span asp-validation-for="Item.LineType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PartId" class="form-label"></label>
                    <input asp-for="Item.PartId" class="form-control" />
                    <span asp-validation-for="Item.PartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ShipmentLineId" class="form-label"></label>
                    <input asp-for="Item.ShipmentLineId" class="form-control" />
                    <span asp-validation-for="Item.ShipmentLineId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <input asp-for="Item.Description" class="form-control" />
                    <span asp-validation-for="Item.Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Quantity" class="form-label"></label>
                    <input asp-for="Item.Quantity" class="form-control" />
                    <span asp-validation-for="Item.Quantity" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.UnitPrice" class="form-label"></label>
                    <input asp-for="Item.UnitPrice" class="form-control" />
                    <span asp-validation-for="Item.UnitPrice" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LineTotal" class="form-label"></label>
                    <input asp-for="Item.LineTotal" class="form-control" />
                    <span asp-validation-for="Item.LineTotal" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="/CustomerInvoiceLine" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
