@page
@model AmusementRideCRM.Pages.CustomerOrder.ExceptionsModel
@{
    ViewData["Title"] = "Order Exceptions Review Queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Order Exceptions Review Queue</h1>
        <p class="text-muted small mb-0">Supervisor review workspace for customer order margin deviations and stock shortages.</p>
    </div>
    <a href="/CustomerOrder" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.FlaggedOrders.Any())
{
    <div class="card shadow-sm border-0 py-5 text-center">
        <div class="card-body">
            <i class="bi bi-shield-check text-success display-4 d-block mb-3"></i>
            <h5 class="fw-semibold">No Pending Exceptions</h5>
            <p class="text-muted mb-0">All customer orders satisfy gross margin limits and inventory availability requirements.</p>
        </div>
    </div>
}
else
{
    <div class="row gap-4">
        @foreach (var order in Model.FlaggedOrders)
        {
            Model.CustomersDict.TryGetValue(order.CustomerId, out var customer);
            Model.OrderLinesDict.TryGetValue(order.OrderId, out var lines);
            lines ??= new List<AmusementRideCRM.Models.CustomerOrderLine>();

            string badgeClass = order.ExceptionStatus switch
            {
                "Approved" => "bg-success",
                "Rejected" => "bg-danger",
                _ => "bg-warning text-dark"
            };

            <div class="card shadow-sm border-0">
                <div class="card-header bg-surface border-bottom d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fs-5 fw-bold text-primary">@order.OrderNumber</span>
                        <span class="badge @badgeClass fs-6">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Exception: @(order.ExceptionStatus ?? "Pending Review")
                        </span>
                        <span class="badge bg-secondary">Order Status: @order.Status</span>
                    </div>
                    <div>
                        <span class="text-muted me-3"><i class="bi bi-calendar3 me-1"></i> @order.OrderDate.ToString("yyyy-MM-dd")</span>
                        <a href="/CustomerOrder/Details?id=@order.OrderId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> View Order Details
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Customer:</strong> @(customer?.CompanyName ?? "Customer #" + order.CustomerId)<br />
                            <strong>Total Amount:</strong> $@order.TotalAmount.ToString("N2")
                        </div>
                        <div class="col-md-8">
                            <strong>Exception Details:</strong>
                            <div class="alert alert-warning py-2 px-3 mt-1 mb-0 small">
                                <i class="bi bi-exclamation-circle me-1"></i> @order.ExceptionReason
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(order.SupervisorComments))
                    {
                        <div class="alert alert-info py-2 px-3 mb-3 small">
                            <strong>Supervisor Notes:</strong> (@order.ApprovedBy at @order.ApprovedDate?.ToString("g")): @order.SupervisorComments
                        </div>
                    }

                    <h6 class="fw-bold mb-2">Order Line Items</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Line #</th>
                                    <th>Part Number</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Avail Stock</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Catalog Cost</th>
                                    <th class="text-end">Margin</th>
                                    <th>Exception Flags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    Model.PartsDict.TryGetValue(line.PartId, out var part);
                                    decimal avail = part != null ? (part.QuantityOnHand - part.ReservedQuantity) : 0m;

                                    <tr class="@(line.HasMarginException || line.HasStockException ? "table-warning" : "")">
                                        <td>@line.LineNumber</td>
                                        <td class="fw-semibold">@(part?.PartNumber ?? "Part #" + line.PartId)</td>
                                        <td>@(part?.Description ?? "-")</td>
                                        <td class="text-end fw-bold">@line.Quantity.ToString("G29")</td>
                                        <td class="text-end @(line.HasStockException ? "text-danger fw-bold" : "")">
                                            @avail.ToString("G29")
                                        </td>
                                        <td class="text-end">$@line.UnitPriceUsd.ToString("N2")</td>
                                        <td class="text-end">$@(line.CostUsd?.ToString("N2") ?? "0.00")</td>
                                        <td class="text-end @(line.HasMarginException ? "text-danger fw-bold" : "")">
                                            @(line.Margin.HasValue ? line.Margin.Value.ToString("P1") : "0%")
                                        </td>
                                        <td>
                                            @if (line.HasMarginException)
                                            {
                                                <span class="badge bg-danger me-1"><i class="bi bi-tag-fill me-1"></i> Margin Exception</span>
                                            }
                                            @if (line.HasStockException)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-box-seam me-1"></i> Stock Shortage</span>
                                            }
                                            @if (!line.HasMarginException && !line.HasStockException)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check me-1"></i> OK</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Supervisor Review Action Form -->
                    <div class="mt-3 p-3 bg-light rounded border">
                        <form method="post">
                            <input type="hidden" name="id" value="@order.OrderId" />
                            <div class="row align-items-center">
                                <div class="col-md-7 mb-2 mb-md-0">
                                    <label for="comments-@order.OrderId" class="form-label small fw-semibold mb-1">Supervisor Review Comments:</label>
                                    <input type="text" id="comments-@order.OrderId" name="comments" class="form-control form-control-sm" placeholder="Enter approval authorization notes or rejection grounds..." value="@order.SupervisorComments" />
                                </div>
                                <div class="col-md-5 text-md-end d-flex gap-2 justify-content-md-end">
                                    <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm px-3">
                                        <i class="bi bi-check-circle me-1"></i> Approve Exception
                                    </button>
                                    <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm px-3">
                                        <i class="bi bi-x-circle me-1"></i> Reject Exception
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        }
    </div>
}
