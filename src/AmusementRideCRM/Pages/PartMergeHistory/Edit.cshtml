@page
@model AmusementRideCRM.Pages.PartMergeHistory.EditModel
@{
    ViewData["Title"] = "Edit PartMergeHistory";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit PartMergeHistory</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.MergeId" />
                <div class="mb-3">
                    <label asp-for="Item.SurvivorPartId" class="form-label"></label>
                    <input asp-for="Item.SurvivorPartId" class="form-control" />
                    <span asp-validation-for="Item.SurvivorPartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MergedPartId" class="form-label"></label>
                    <input asp-for="Item.MergedPartId" class="form-control" />
                    <span asp-validation-for="Item.MergedPartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MergedDate" class="form-label"></label>
                    <input asp-for="Item.MergedDate" class="form-control" />
                    <span asp-validation-for="Item.MergedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MergedByUserId" class="form-label"></label>
                    <input asp-for="Item.MergedByUserId" class="form-control" />
                    <span asp-validation-for="Item.MergedByUserId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MergedByUserName" class="form-label"></label>
                    <input asp-for="Item.MergedByUserName" class="form-control" />
                    <span asp-validation-for="Item.MergedByUserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.MergeDetails" class="form-label"></label>
                    <input asp-for="Item.MergeDetails" class="form-control" />
                    <span asp-validation-for="Item.MergeDetails" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/PartMergeHistory" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
