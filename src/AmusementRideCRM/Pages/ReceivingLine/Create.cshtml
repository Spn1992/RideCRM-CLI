@page
@model AmusementRideCRM.Pages.ReceivingLine.CreateModel
@{
    ViewData["Title"] = "Create ReceivingLine";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Create ReceivingLine</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Item.ReceivingId" class="form-label"></label>
                    <input asp-for="Item.ReceivingId" class="form-control" />
                    <span asp-validation-for="Item.ReceivingId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.POLineId" class="form-label"></label>
                    <input asp-for="Item.POLineId" class="form-control" />
                    <span asp-validation-for="Item.POLineId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PartId" class="form-label"></label>
                    <input asp-for="Item.PartId" class="form-control" />
                    <span asp-validation-for="Item.PartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityExpected" class="form-label"></label>
                    <input asp-for="Item.QuantityExpected" class="form-control" />
                    <span asp-validation-for="Item.QuantityExpected" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityReceived" class="form-label"></label>
                    <input asp-for="Item.QuantityReceived" class="form-control" />
                    <span asp-validation-for="Item.QuantityReceived" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityDamaged" class="form-label"></label>
                    <input asp-for="Item.QuantityDamaged" class="form-control" />
                    <span asp-validation-for="Item.QuantityDamaged" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LocationId" class="form-label"></label>
                    <input asp-for="Item.LocationId" class="form-control" />
                    <span asp-validation-for="Item.LocationId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.HoldingLocationId" class="form-label"></label>
                    <input asp-for="Item.HoldingLocationId" class="form-control" />
                    <span asp-validation-for="Item.HoldingLocationId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.HasDiscrepancy" class="form-label"></label>
                    <input asp-for="Item.HasDiscrepancy" class="form-control" />
                    <span asp-validation-for="Item.HasDiscrepancy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.DiscrepancyNotes" class="form-label"></label>
                    <input asp-for="Item.DiscrepancyNotes" class="form-control" />
                    <span asp-validation-for="Item.DiscrepancyNotes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.LabelQty" class="form-label"></label>
                    <input asp-for="Item.LabelQty" class="form-control" />
                    <span asp-validation-for="Item.LabelQty" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="/ReceivingLine" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
