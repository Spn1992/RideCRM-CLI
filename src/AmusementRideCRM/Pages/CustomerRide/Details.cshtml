@page
@model AmusementRideCRM.Pages.CustomerRide.DetailsModel
@{
    ViewData["Title"] = "Customer Ride Details & Component History";
    ViewData["ActivePage"] = "Rides";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold text-primary-custom">Ride Specification & Location</h5>
            <div>
                <a href="/CustomerRide/Edit?id=@Model.Item.RideId" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit Ride</a>
                <a href="/CustomerRide" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Customer / Operator</span>
                    <span class="fw-semibold">@(Model.Customer?.CompanyName ?? $"Customer #{Model.Item.CustomerId}")</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Manufacturer & Model</span>
                    <span class="fw-semibold">@Model.Item.RideManufacturer @Model.Item.RideModel</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Ride Serial Number</span>
                    <span class="badge bg-light text-dark font-monospace fs-6">@(string.IsNullOrEmpty(Model.Item.SerialNumber) ? "N/A" : Model.Item.SerialNumber)</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Year Manufactured</span>
                    <span>@(Model.Item.YearManufactured?.ToString() ?? "N/A")</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Status</span>
                    <span class="badge @(Model.Item.IsActive ? "bg-success" : "bg-secondary")">@(Model.Item.IsActive ? "Active Operational" : "Decommissioned")</span>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Notes</span>
                    <span>@(string.IsNullOrEmpty(Model.Item.Notes) ? "-" : Model.Item.Notes)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Installed Component History Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom"><i class="bi bi-cpu me-2"></i>Installed Serialized Component History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Part Number</th>
                            <th>Description</th>
                            <th>Serial Number</th>
                            <th>Installed Date</th>
                            <th>Warranty Expiration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.InstalledComponents.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No serialized components registered on this customer ride yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var unit in Model.InstalledComponents)
                            {
                                var isExpired = unit.WarrantyEndDate.HasValue && unit.WarrantyEndDate.Value < DateTime.UtcNow;
                                <tr>
                                    <td class="ps-4 fw-semibold"><span class="badge bg-light text-dark font-monospace">@(unit.Part?.PartNumber ?? $"Part #{unit.PartId}")</span></td>
                                    <td>@(unit.Part?.Description ?? "-")</td>
                                    <td><span class="badge bg-primary font-monospace">@unit.SerialNumber</span></td>
                                    <td>@unit.ShippedDate?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (unit.WarrantyEndDate.HasValue)
                                        {
                                            <span class="badge @(isExpired ? "bg-secondary" : "bg-success")">@unit.WarrantyEndDate.Value.ToString("yyyy-MM-dd") @(isExpired ? "(Expired)" : "(Active)")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-info text-dark">@unit.Status</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
