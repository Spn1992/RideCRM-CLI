@page
@model AmusementRideCRM.Pages.CustomerRide.CreateModel
@{
    ViewData["Title"] = "Create CustomerRide";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Create CustomerRide</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Item.CustomerId" class="form-label"></label>
                    <input asp-for="Item.CustomerId" class="form-control" />
                    <span asp-validation-for="Item.CustomerId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.RideManufacturer" class="form-label"></label>
                    <input asp-for="Item.RideManufacturer" class="form-control" />
                    <span asp-validation-for="Item.RideManufacturer" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.RideModel" class="form-label"></label>
                    <input asp-for="Item.RideModel" class="form-control" />
                    <span asp-validation-for="Item.RideModel" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.SerialNumber" class="form-label"></label>
                    <input asp-for="Item.SerialNumber" class="form-control" />
                    <span asp-validation-for="Item.SerialNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.YearManufactured" class="form-label"></label>
                    <input asp-for="Item.YearManufactured" class="form-control" />
                    <span asp-validation-for="Item.YearManufactured" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.IsActive" class="form-label"></label>
                    <input asp-for="Item.IsActive" class="form-control" />
                    <span asp-validation-for="Item.IsActive" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedDate" class="form-label"></label>
                    <input asp-for="Item.CreatedDate" class="form-control" />
                    <span asp-validation-for="Item.CreatedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedBy" class="form-label"></label>
                    <input asp-for="Item.CreatedBy" class="form-control" />
                    <span asp-validation-for="Item.CreatedBy" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedDate" class="form-label"></label>
                    <input asp-for="Item.ModifiedDate" class="form-control" />
                    <span asp-validation-for="Item.ModifiedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ModifiedBy" class="form-label"></label>
                    <input asp-for="Item.ModifiedBy" class="form-control" />
                    <span asp-validation-for="Item.ModifiedBy" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="/CustomerRide" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
