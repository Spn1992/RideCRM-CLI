@page
@model AmusementRideCRM.Pages.InventoryReservation.EditModel
@{
    ViewData["Title"] = "Edit InventoryReservation";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-surface border-bottom py-3">
            <h5 class="mb-0 fw-semibold text-primary-custom">Edit InventoryReservation</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Item.ReservationId" />
                <div class="mb-3">
                    <label asp-for="Item.OrderLineId" class="form-label"></label>
                    <input asp-for="Item.OrderLineId" class="form-control" />
                    <span asp-validation-for="Item.OrderLineId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.PartId" class="form-label"></label>
                    <input asp-for="Item.PartId" class="form-control" />
                    <span asp-validation-for="Item.PartId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.QuantityReserved" class="form-label"></label>
                    <input asp-for="Item.QuantityReserved" class="form-control" />
                    <span asp-validation-for="Item.QuantityReserved" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.HoldingLocationId" class="form-label"></label>
                    <input asp-for="Item.HoldingLocationId" class="form-control" />
                    <span asp-validation-for="Item.HoldingLocationId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ReservationDate" class="form-label"></label>
                    <input asp-for="Item.ReservationDate" class="form-control" />
                    <span asp-validation-for="Item.ReservationDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Status" class="form-label"></label>
                    <input asp-for="Item.Status" class="form-control" />
                    <span asp-validation-for="Item.Status" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.ReleasedDate" class="form-label"></label>
                    <input asp-for="Item.ReleasedDate" class="form-control" />
                    <span asp-validation-for="Item.ReleasedDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.Notes" class="form-label"></label>
                    <input asp-for="Item.Notes" class="form-control" />
                    <span asp-validation-for="Item.Notes" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Item.CreatedBy" class="form-label"></label>
                    <input asp-for="Item.CreatedBy" class="form-control" />
                    <span asp-validation-for="Item.CreatedBy" class="text-danger"></span>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/InventoryReservation" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
